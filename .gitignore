# Compiled Python files
*.pyc
*.pyo
*.pyd
__pycache__/

# Virtual environments
venv-3.11.7/

# Folders generated by Django
staticfiles/             # Folders of static files collected by Django
staticfiles_build/       # Folders of built static files
*.log                    # Ignore generated log files
*.pot                    # Django translation files
db.sqlite3               # Ignore SQLite database file
*.sqlite3                # If using SQLite for databases

# Data folders and files
data/corpus/             # Folder containing corpora, ignore if you don't want to version these data
data/functions/          # Folder with local functions to ignore
data/models/             # Training models (e.g., .h5 files)
data/pretraining/        # Pretraining encoders (.joblib files)

# Local configuration files
*.env
*.local

# Jupyter notebook folders
notebooks/               # Folder containing Jupyter notebooks, typically not versioned

# Backup and temporary files
*~
*.bak
*.swp

# Editor-specific files and directories
.idea/                   # If using PyCharm, ignore IDE configuration files
.vscode/                 # If using Visual Studio Code

# OS-specific configuration files
*.DS_Store               # Ignore macOS-specific files
Thumbs.db                # Ignore Windows-specific files

# Cache files
.cache/                  # Cache of applications and dependencies
